OPENQASM 2.0;
include "qelib1.inc";

qreg q[4];
creg c[4];

// Initial layer of arbitrary single-qubit unitaries
u3(0.5123, 1.1021, -0.7854) q[0];
u3(1.2345, -0.5127, 0.3456) q[1];
u3(-0.8124, 0.2345, 1.0472) q[2];
u3(0.9231, -1.2566, 0.8727) q[3];

// Entangling layer
cx q[0], q[1];
cx q[1], q[2];
cx q[2], q[3];

// Variational layer 1
u3(0.6758, -0.3412, 1.1345) q[0];
u3(-1.0470, 0.7854, -0.4567) q[1];
u3(0.9345, -1.1284, 0.5678) q[2];
u3(-0.6423, 1.0472, -1.2034) q[3];
cx q[0], q[1];
cx q[1], q[2];
cx q[2], q[3];

// Variational layer 2
u3(1.2479, -0.8727, 0.3927) q[0];
u3(-0.9456, 1.4586, -0.2199) q[1];
u3(0.8157, -0.3413, 1.3080) q[2];
u3(-1.1345, 0.8923, -0.7156) q[3];
cx q[0], q[2];
cx q[1], q[3];
cx q[0], q[1];

// Variational layer 3
u3(0.7234, -1.0472, 0.3185) q[0];
u3(-0.5123, 0.6896, -1.1781) q[1];
u3(1.1781, -0.9231, 0.7649) q[2];
u3(-0.8940, 1.2043, -0.4671) q[3];
cx q[2], q[3];
cx q[0], q[3];
cx q[1], q[2];

// Final single-qubit layer
u3(-0.3820, 1.3614, -0.9250) q[0];
u3(1.0472, -0.7854, 0.6521) q[1];
u3(-0.7649, 0.9817, -1.1055) q[2];
u3(0.5371, -1.4036, 0.3299) q[3];

measure q[0] -> c[0];
measure q[1] -> c[1];
measure q[2] -> c[2];
measure q[3] -> c[3];
