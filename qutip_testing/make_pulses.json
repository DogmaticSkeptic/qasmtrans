import json
import numpy as np

def gaussian(t, t0, sigma):
    return np.exp(-0.5*((t - t0)/sigma)**2)

dt = 0.5e-9
T = 200e-9
t = np.arange(0.0, T + dt/2, dt)

I1 = gaussian(t, 40e-9, 8e-9)
Q1 = np.zeros_like(t)
I2 = gaussian(t, 80e-9, 8e-9)
Q2 = np.zeros_like(t)
s = gaussian(t, 140e-9, 10e-9)

I1 = np.clip(I1, 0.0, 1.0)
Q1 = np.clip(Q1, 0.0, 1.0)
I2 = np.clip(I2, 0.0, 1.0)
Q2 = np.clip(Q2, 0.0, 1.0)
s = np.clip(s, 0.0, 1.0)

data = {
    "s_envelope": list(map(float, s)),
    "I1_envelope": list(map(float, I1)),
    "Q1_envelope": list(map(float, Q1)),
    "I2_envelope": list(map(float, I2)),
    "Q2_envelope": list(map(float, Q2))
}

with open("pulses_envelopes.json", "w") as f:
    json.dump(data, f, indent=2)

print("Wrote pulses_envelopes.json")
print("Samples:", len(t), "Duration [ns]:", T*1e9, "dt [ns]:", dt*1e9)

